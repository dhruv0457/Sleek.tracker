DATABASE_URL="file:./prisma/dev.db"

# Production (Vercel / Supabase / Neon PostgreSQL):
#   Paste your Postgres connection string here. Example Supabase format:
#   postgresql://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#   (use port 5432 for direct connection, 6543 for Supabase's PgBouncer pooler)
#   On Vercel, set this as a Production env var in the dashboard.
# DATABASE_URL="postgresql://..."
SESSION_SECRET="change-this-to-a-long-random-string-at-least-32-chars-long"

# --- App URL ---
# Local dev default. For production: your Vercel deployment URL (e.g. https://your-app.vercel.app).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NVIDIA_API_KEY=nvapi-

GMAIL_USER=sleek-reminders@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

CRON_SECRET=change-this-to-a-random-string
OWNER_EMAIL=you@example.com

