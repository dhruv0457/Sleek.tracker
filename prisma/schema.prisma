generator client {
  provider = "prisma-client-js"
}

// Prisma 7 driver-adapter mode: actual DB connection is provided at runtime
// by the adapter configured in src/lib/prisma.ts. The provider here only
// affects `prisma migrate dev` / `prisma db push` CLI runs.
//
//   • Local dev (SQLite):       keep `provider = "sqlite"` and run
//                               `DATABASE_URL="file:./prisma/dev.db" npm run db:push`
//   • Vercel production (PG):   temporarily switch to `provider = "postgresql"`
//                               before running migrations against your Supabase/
//                               Neon DATABASE_URL, OR generate the SQL with
//                               `prisma migrate diff` against the PG schema.
datasource db {
  provider = "sqlite"
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String?
  password     String?
  provider     String     @default("email") // "email" | "google"
  avatar       String?
  bio          String?
  locality     String?
  tier         String     @default("free") // "free" | "basic_pro" | "ultra_pro"
  trialEndAt   DateTime?
  resetCode    String?    // 6-digit forgot-password code
  resetCodeExpiresAt DateTime?
  createdAt    DateTime   @default(now())
  settings      UserSettings?
  habits       Habit[]
  badges       Badge[]
  trophies     Trophy[]
  contacts      Contact[]
  reminders    Reminder[]
  aiMessages   AiMessage[]
  logs         DailyLog[]
  aiVerifications AIVerification[]
  focusSessions FocusSession[]
  achievements  Achievement[]
}

model UserSettings {
  userId         String   @id
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  multitaskingDefault Boolean @default(false)
  emailsMorning  Boolean  @default(true)
  emailsEvening  Boolean  @default(true)
  pushEnabled    Boolean  @default(true)
  autoSkipOn     Boolean  @default(true)
  weekStartMon   Boolean  @default(true)
  weeklyMondayReminder Boolean @default(false) // send a Monday-morning task digest
  theme          String   @default("light") // "light" | "dark"
  timezone       String?  // IANA tz, e.g. "Asia/Kolkata". null -> fall back to server clock.
  updatedAt      DateTime @updatedAt
}

model Contact {
  id        String   @id @default(cuid())
  userId    String?
  fromName  String
  fromEmail String
  subject   String   @default("(no subject)")
  message   String
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model Habit {
  id              String    @id @default(cuid())
  userId          String
  name            String
  description     String?
  color           String    @default("#22a558")
  targetMins      Int       @default(30)
  intensityTarget Int       @default(100) // 80 | 90 | 100 percent capacity target
  requiresCamera  Boolean   @default(false) // triggers AI Verifier flow
  schedule        String    @default("daily")
  createdAt       DateTime  @default(now())
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkins        CheckIn[]
  reminders       Reminder[]

  @@index([userId])
}

model CheckIn {
  id            String   @id @default(cuid())
  habitId       String
  date          String   // YYYY-MM-DD (immutable once locked)
  minutes       Int      @default(0)
  completed     Boolean  @default(false)
  status        String   @default("pending") // pending | done | missed | skipped | multitask
  intensity     Int      @default(0) // 0-100 self-reported capacity
  multitasking  Boolean  @default(false)
  locked        Boolean  @default(false) // STRICT immutability: any done/missed/skipped locks forever
  note          String?
  createdAt     DateTime @default(now())
  habit          Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@index([habitId, date])
}

// Long-term immutable record per user per day (per spec section 13.3)
model DailyLog {
  id        String   @id @default(cuid())
  userId    String
  date      String   // YYYY-MM-DD
  summary   String   // JSON: aggregate of tasks that day
  intensityAvg Int   @default(0)
  badgesEarned Int    @default(0)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

// In-browser AI Verifier records (links a CheckIn-less habit to a photo + result)
model AIVerification {
  id        String   @id @default(cuid())
  userId    String
  habitId   String
  date      String   // YYYY-MM-DD
  label     String   // top MobileNet label
  confidence Float  // 0-1
  passed    Boolean
  blurry    Boolean
  imageDataUrl String? // kept small (postage-stamp thumbnail)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model Reminder {
  id        String   @id @default(cuid())
  userId    String
  habitId   String?
  time      String   // "HH:MM" 24h, e.g. "11:00", "15:15"
  label     String
  message   String   @default("") // multi-line email body (optional, max 2000 chars)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  habit     Habit?   @relation(fields: [habitId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model Badge {
  id         String   @id @default(cuid())
  userId     String
  badgeId    String
  level      Int      @default(1)
  line        String
  unlockedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId])
}

// 5 badges = 30 trophies; user's rank on leaderboard
model Trophy {
  id         String   @id @default(cuid())
  userId     String
  count      Int      @default(0) // total trophies — computed by trophies.ts
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
}

// FocusSession — stored per completed (or discarded) focus block.
// Used by the badge/trophy math to sum total focus minutes and count sessions.
model FocusSession {
  id            String   @id @default(cuid())
  userId        String
  durationSec   Int      @default(0)  // total seconds of this session
  completed     Boolean  @default(true) // false = discarded
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Persist User's achievement tree node unlocks (so the tree remembers
// which nodes were "revealed" even after milestones). Optional — the
// badges route computes achievements dynamically anyway.
model Achievement {
  id            String   @id @default(cuid())
  userId        String
  level         Int      // 1-7
  unlockedAt    DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, level])
}

// AI Insights chat history (Gemini) — context injected from logs
model AiMessage {
  id        String   @id @default(cuid())
  userId    String
  role      String   // "user" | "model"
  content   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ─────────────── Deleted-account archive ───────────────
// When a user removes their account, their live User row + all related
// rows (habits, checkins, badges, etc.) are cascade-deleted, BUT first
// we snapshot a JSON blob containing everything into PastUser. Keyed by
// email — on next sign-up with the same email, the data restore flow
// copies the snapshot back into the live tables and removes the PastUser
// row, so the user gets their habits and history back automatically.
model PastUser {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  avatar    String?
  provider  String   @default("email")
  // JSON snapshot of: settings, habits[] (with checkins), badges[],
  // trophies, reminders[], focusSessions[], achievements[], aiMessages[],
  // aiVerifications[], dailyLogs[].
  snapshot   String
  deletedAt DateTime @default(now())

  @@index([email])
}
