generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String           @id @default(cuid())
  email              String           @unique
  name               String?
  password           String?
  provider           String           @default("email")
  avatar             String?
  bio                String?
  locality           String?
  tier               String           @default("free")
  trialEndAt         DateTime?
  resetCode          String?
  resetCodeExpiresAt DateTime?
  createdAt          DateTime         @default(now())
  aiVerifications    AIVerification[]
  achievements       Achievement[]
  aiMessages         AiMessage[]
  badges             Badge[]
  contacts           Contact[]
  logs               DailyLog[]
  focusSessions      FocusSession[]
  habits             Habit[]
  reminders          Reminder[]
  trophies           Trophy?
  settings           UserSettings?
}

model UserSettings {
  userId               String   @id
  multitaskingDefault  Boolean  @default(false)
  emailsMorning        Boolean  @default(true)
  emailsEvening        Boolean  @default(true)
  pushEnabled          Boolean  @default(true)
  autoSkipOn           Boolean  @default(true)
  weekStartMon         Boolean  @default(true)
  weeklyMondayReminder Boolean  @default(false)
  theme                String   @default("light")
  timezone             String?
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Contact {
  id        String   @id @default(cuid())
  userId    String?
  fromName  String
  fromEmail String
  subject   String   @default("(no subject)")
  message   String
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Habit {
  id              String     @id @default(cuid())
  userId          String
  name            String
  description     String?
  color           String     @default("#22a558")
  targetMins      Int        @default(30)
  intensityTarget Int        @default(100)
  requiresCamera  Boolean    @default(false)
  schedule        String     @default("daily")
  createdAt       DateTime   @default(now())
  checkins        CheckIn[]
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  reminders       Reminder[]

  @@index([userId])
}

model CheckIn {
  id           String   @id @default(cuid())
  habitId      String
  date         String
  minutes      Int      @default(0)
  completed    Boolean  @default(false)
  status       String   @default("pending")
  intensity    Int      @default(0)
  multitasking Boolean  @default(false)
  locked       Boolean  @default(false)
  note         String?
  createdAt    DateTime @default(now())
  habit        Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@index([habitId, date])
}

model DailyLog {
  id           String   @id @default(cuid())
  userId       String
  date         String
  summary      String
  intensityAvg Int      @default(0)
  badgesEarned Int      @default(0)
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

model AIVerification {
  id           String   @id @default(cuid())
  userId       String
  habitId      String
  date         String
  label        String
  confidence   Float
  passed       Boolean
  blurry       Boolean
  imageDataUrl String?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model Reminder {
  id        String   @id @default(cuid())
  userId    String
  habitId   String?
  time      String
  label     String
  message   String   @default("")
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  habit     Habit?   @relation(fields: [habitId], references: [id])
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Badge {
  id         String   @id @default(cuid())
  userId     String
  badgeId    String
  level      Int      @default(1)
  line       String
  unlockedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId])
}

model Trophy {
  id        String   @id @default(cuid())
  userId    String   @unique
  count     Int      @default(0)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FocusSession {
  id          String   @id @default(cuid())
  userId      String
  durationSec Int      @default(0)
  completed   Boolean  @default(true)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Achievement {
  id         String   @id @default(cuid())
  userId     String
  level      Int
  unlockedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, level])
}

model AiMessage {
  id        String   @id @default(cuid())
  userId    String
  role      String
  content   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model PastUser {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  avatar    String?
  provider  String   @default("email")
  snapshot  String
  deletedAt DateTime @default(now())

  @@index([email])
}
